# Folder where a git URL is cloned, as owner/repo under this path.
# Use an absolute path, or a path relative to this file.
#
# Linux/macOS example:
# CLONE_ROOT=/var/tmp/clean
#
# Windows example:
# CLONE_ROOT=C:/Users/you/clean
CLONE_ROOT=./clones

# Optional: default target when the CLI is run with no path (also reads REPO_URL / DEMO_REPO from the shell).
# REPO_URL=https://github.com/<owner>/test-affected-repo.git
